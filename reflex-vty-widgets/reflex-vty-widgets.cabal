cabal-version: 3.0
name: reflex-vty-widgets
version: 0.1.0.0
synopsis: Companion widget primitives for reflex-vty
description:
  Remappable key bindings with generated help, layout spacing and grid
  helpers, pagination, and modal overlay widgets built on reflex-vty.
license: BSD-3-Clause
license-file: LICENSE
author: Obsidian Systems LLC
maintainer: maintainer@obsidian.systems
copyright: 2025 Obsidian Systems LLC
category: FRP
build-type: Simple
extra-source-files:
  ChangeLog.md
tested-with:
  GHC ==9.8.4 || ==9.10.1 || == 9.12.2

source-repository head
  type: git
  location: https://github.com/reflex-frp/reflex-vty

common library-settings
  default-language: Haskell2010
  ghc-options: -Wall
  default-extensions:
    ConstraintKinds
    FlexibleContexts
    LambdaCase
    OverloadedStrings
    RankNTypes
    RecursiveDo
    ScopedTypeVariables
    TupleSections
    TypeApplications

library
  import: library-settings
  exposed-modules:
    Reflex.Vty.Widget
    Reflex.Vty.Widget.Grid
    Reflex.Vty.Widget.Key
    Reflex.Vty.Widget.Layout.Spacing
    Reflex.Vty.Widget.List
    Reflex.Vty.Widget.Overlay
    Reflex.Vty.Widget.Paginator
  hs-source-dirs: src
  build-depends:
    base >=4.19 && <4.22,
    containers >=0.5 && <0.8,
    data-default >=0.7.1 && <0.9,
    reflex >=0.9.2 && <1,
    reflex-vty >=1.3.0.0 && <1.4,
    ordered-containers >=0.2.2 && <0.3,
    text >=1.2.3 && <2.2,
    transformers >=0.5.5 && <0.7,
    vty >=6.0 && <6.7

executable widgets-demo
  import: library-settings
  hs-source-dirs: app
  main-is: Main.hs
  other-modules:
    Example.TierA
  ghc-options: -threaded -Wall
  build-depends:
    base,
    containers,
    data-default,
    reflex,
    reflex-vty,
    reflex-vty-widgets,
    text,
    transformers,
    vty

executable articles-demo
  import: library-settings
  hs-source-dirs: app
  main-is: ArticlesMain.hs
  other-modules:
    Example.Articles
  ghc-options: -threaded -Wall
  build-depends:
    base,
    containers,
    data-default,
    ordered-containers,
    reflex,
    reflex-vty,
    reflex-vty-widgets,
    text,
    transformers,
    vty

test-suite reflex-vty-widgets-test
  import: library-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test test-support app
  main-is: Spec.hs
  ghc-options: -threaded -Wall
  other-modules:
    Example.Articles
    Example.ArticlesSpec
    Example.TierA
    Example.TierASpec
    Reflex.Vty.Test.AppHarness
    Reflex.Vty.Test.Snapshot
    Reflex.Vty.Widget.KeySpec
    Reflex.Vty.Widget.Layout.SpacingSpec
    Reflex.Vty.Widget.ListSpec
    Reflex.Vty.Widget.GridSpec
    Reflex.Vty.Widget.PaginatorSpec
    Reflex.Vty.Widget.OverlaySpec
  build-depends:
    async >=2.2.6 && <2.3,
    base,
    bytestring,
    containers,
    data-default,
    directory,
    exceptions,
    filepath,
    hspec >=2.7 && <2.12,
    ordered-containers >=0.2.2 && <0.3,
    reflex,
    reflex-vty,
    reflex-vty-widgets,
    stm,
    text,
    transformers,
    vector >=0.12 && <0.14,
    vty
  if !os(windows)
    build-depends: unix

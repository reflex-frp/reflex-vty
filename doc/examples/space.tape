# Render with: bash doc/record-example.sh space
Output doc/examples/space.gif
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set Width 680
Set Height 300
Set Padding 6
Set Theme "Dracula"
Set Framerate 20
Set WaitTimeout 180s

Hide
Type "bash doc/run-examples.sh space"
Enter
Sleep 3500ms
Show

Sleep 4500ms

Hide
Type "q"
Sleep 300ms

# Render with: bash doc/record-example.sh canvas
Output doc/examples/canvas.gif
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 20
Set Width 720
Set Height 240
Set Padding 16
Set Theme "Dracula"
Set WaitTimeout 180s

Hide
Type "bash doc/run-examples.sh canvas"
Enter
Wait+Screen /arrows: move/
Sleep 300ms
Show

Sleep 800ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Down
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Down
Sleep 700ms
Left
Sleep 700ms
Left
Sleep 700ms
Up
Sleep 700ms

Hide
Type "q"
Sleep 300ms
